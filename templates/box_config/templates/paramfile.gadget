# bound memory usage
MaxMemSizePerNode = 16000

#  Relevant files
InitCondFile = IC/IC
OutputDir = output
OutputList = 0.1,0.5,1.0
# CPU time -limit

TimeLimitCPU = 84600 #= 23.5 hours

# Code options

#  Characteristics of run

TimeMax = 1.0

Omega0 = 0.288      # Total matter density  (at z=0)

MassiveNuLinRespOn = 0
HydroOn = 1
CoolingOn = 1
StarformationOn = 1
DensityIndependentSphOn = 1

SnapshotWithFOF = 1

# Memory allocation
PartAllocFactor = 2.0

#----------------------BH Stuff-------------------------
BlackHoleOn = 1
MetalReturnOn = 1
WindOn = 1
